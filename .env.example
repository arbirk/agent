# LLM Endpoint Configuration
# Supports standard OpenAI-compatible /chat/completions (default) or REST chat endpoints
LLM_BASE_URL=https://api.internal.corp/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o

# Endpoint Type: 'chat' (OpenAI-compatible) or 'rest' (POST /chat/message + POST /chat/generate)
LLM_API_TYPE=chat

# Optional custom header (e.g. 'api-key' for Azure, defaults to 'Authorization')
# LLM_AUTH_HEADER=Authorization

# Token Limits
MAX_TURN_TOKENS=4000
MAX_TOTAL_CONTEXT_TOKENS=32000

# Agent Settings
AGENT_DEFAULT_SHELL=powershell
AGENT_TIMEOUT_MS=60000
